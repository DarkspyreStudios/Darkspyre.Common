<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AnalysisLevelStyle>latest-none</AnalysisLevelStyle>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Copyright>Copyright (c) 2026 Darkspyre Studios, LLC</Copyright>
    <Company>Darkspyre Studios</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- Library versions: <net>.<major>.<minor>.<build>. The first part is the .NET major version the libraries target
         (net11.0). The last part goes up by one when the library's code changes. Each library's csproj sets
         <Version> from its property. -->
    <DarkspyreCommonGitVersion>11.0.10.16</DarkspyreCommonGitVersion>
    <DarkspyreCommonPdfVersion>11.0.10.1</DarkspyreCommonPdfVersion>
    <DarkspyreCommonPdfPdfiumVersion>11.0.10.2</DarkspyreCommonPdfPdfiumVersion>
    <DarkspyreCommonWorkspacesVersion>11.0.10.4</DarkspyreCommonWorkspacesVersion>
    <DarkspyreAgentCommonUiVersion>11.0.10.16</DarkspyreAgentCommonUiVersion>
    <DarkspyreCommonMarkdownVersion>11.0.1.1</DarkspyreCommonMarkdownVersion>
    <DarkspyreMobileComponentsVersion>11.0.1.4</DarkspyreMobileComponentsVersion>
    <DarkspyreMobileMauiVersion>11.0.1.0</DarkspyreMobileMauiVersion>
    <DarkspyreLocalServicesContractsVersion>11.0.10.7</DarkspyreLocalServicesContractsVersion>
    <DarkspyreLocalServicesVersion>11.0.10.15</DarkspyreLocalServicesVersion>
    <DarkspyreLocalServicesPlatformMacOSVersion>11.0.10.7</DarkspyreLocalServicesPlatformMacOSVersion>
    <DarkspyreLocalServicesPlatformLinuxVersion>11.0.10.8</DarkspyreLocalServicesPlatformLinuxVersion>
    <DarkspyreLocalServicesPlatformWindowsVersion>11.0.10.8</DarkspyreLocalServicesPlatformWindowsVersion>
  </PropertyGroup>
</Project>
