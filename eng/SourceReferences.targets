<Project>
  <!-- Source mode for consumers of the Darkspyre.Common packages. A consuming repository imports this file from its
       Directory.Build.targets when DarkspyreCommonSourceRoot names a Darkspyre.Common checkout. Each Darkspyre.Common
       PackageReference becomes a ProjectReference to its project, keeping its asset metadata. -->
  <ItemGroup>
    <_DarkspyreCommonSourceProject Include="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Common.Git')->'$(MSBuildThisFileDirectory)../src/Darkspyre.Common.Git/Darkspyre.Common.Git.csproj')" />
    <_DarkspyreCommonSourceProject Include="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Common.Pdf')->'$(MSBuildThisFileDirectory)../src/Darkspyre.Common.Pdf/Darkspyre.Common.Pdf.csproj')" />
    <_DarkspyreCommonSourceProject Include="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Common.Pdf.Pdfium')->'$(MSBuildThisFileDirectory)../src/Darkspyre.Common.Pdf.Pdfium/Darkspyre.Common.Pdf.Pdfium.csproj')" />
    <PackageReference Remove="Darkspyre.Common.Git;Darkspyre.Common.Pdf;Darkspyre.Common.Pdf.Pdfium" />
    <ProjectReference Include="@(_DarkspyreCommonSourceProject)">
      <Private Condition="'%(ExcludeAssets)' == 'all' or $([System.String]::Copy(';%(ExcludeAssets);').Contains(';runtime;'))">false</Private>
      <ReferenceOutputAssembly Condition="'%(ExcludeAssets)' == 'all' or $([System.String]::Copy(';%(ExcludeAssets);').Contains(';compile;'))">false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
</Project>
