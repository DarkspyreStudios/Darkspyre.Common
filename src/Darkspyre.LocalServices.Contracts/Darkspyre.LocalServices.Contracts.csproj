<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>$(DarkspyreLocalServicesContractsVersion)</Version>
    <IsPackable>false</IsPackable>
    <DebugType>portable</DebugType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <Authors>Darkspyre Studios</Authors>
    <Company>Darkspyre Studios</Company>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/DarkspyreStudios/Darkspyre.Common</RepositoryUrl>
  </PropertyGroup>
  <PropertyGroup><GenerateDocumentationFile>true</GenerateDocumentationFile></PropertyGroup>
</Project>
