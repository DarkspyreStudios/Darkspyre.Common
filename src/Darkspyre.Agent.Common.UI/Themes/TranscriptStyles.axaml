<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="using:Darkspyre.Agent.Common.UI.Icons">
  <!-- Transcript. -->
  <Style Selector="StackPanel.transcript-messages">
    <Setter Property="Margin" Value="36,20,36,8" />
  </Style>
  <!-- The round Scroll to newest button: a 32 px circle, centred, 12 px above the transcript's lower edge. -->
  <Style Selector="Button.newest">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>
  <!-- The arrow shows while the conversation is idle, the dots while it works. -->
  <Style Selector="Button.newest StackPanel.newest-dots">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Button.newest.working StackPanel.newest-dots">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="Button.newest.working icons|Icon.newest-arrow">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <!-- Each dot rises 2 px and settles back once a cycle; the second and third start 0.15 s and 0.3 s after the first. -->
  <Style Selector="Button.newest.working Ellipse.newest-dot.first">
    <Style.Animations>
      <Animation Duration="0:0:1.2" IterationCount="Infinite" Easing="SineEaseInOut">
        <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
        <KeyFrame Cue="25%"><Setter Property="TranslateTransform.Y" Value="-2" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Button.newest.working Ellipse.newest-dot.second">
    <Style.Animations>
      <Animation Duration="0:0:1.2" Delay="0:0:0.15" IterationCount="Infinite" Easing="SineEaseInOut">
        <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
        <KeyFrame Cue="25%"><Setter Property="TranslateTransform.Y" Value="-2" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Button.newest.working Ellipse.newest-dot.third">
    <Style.Animations>
      <Animation Duration="0:0:1.2" Delay="0:0:0.3" IterationCount="Infinite" Easing="SineEaseInOut">
        <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
        <KeyFrame Cue="25%"><Setter Property="TranslateTransform.Y" Value="-2" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="TextBlock.transcript-older-loading">
    <Setter Property="Margin" Value="0,0,0,20" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource faint.brush}" />
    <Setter Property="FontFamily" Value="{DynamicResource font-secondary}" />
    <Setter Property="FontSize" Value="{DynamicResource font-size-secondary}" />
  </Style>
  <Style Selector="Border.turn">
    <Setter Property="Margin" Value="0,0,0,20" />
  </Style>
  <Style Selector="Border.turn TextBlock.prompt-text">
    <Setter Property="FontFamily" Value="{DynamicResource font-body}" />
    <Setter Property="FontSize" Value="{DynamicResource font-size-body}" />
  </Style>
  <!-- A user turn is the component library's user bubble: the muted fill, rounded, at the right. -->
  <Style Selector="Border.turn.user > StackPanel > Border.turn-bubble">
    <Setter Property="Background" Value="{DynamicResource color-muted.brush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource radius-lg}" />
    <Setter Property="Padding" Value="16,10" />
  </Style>
  <Style Selector="TextBlock.turn-source, TextBlock.queued-state">
    <Setter Property="Margin" Value="0,0,0,5" />
    <Setter Property="FontFamily" Value="{DynamicResource font-caption}" />
    <Setter Property="FontSize" Value="{DynamicResource font-size-caption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.7" />
  </Style>
  <Style Selector="TextBlock.turn-source">
    <Setter Property="Foreground" Value="{DynamicResource faint.brush}" />
  </Style>
  <Style Selector="TextBlock.queued-notice">
    <Setter Property="Margin" Value="0,6,0,0" />
    <Setter Property="Padding" Value="8,0,0,0" />
    <Setter Property="FontFamily" Value="{DynamicResource font-secondary}" />
    <Setter Property="FontSize" Value="{DynamicResource font-size-secondary}" />
  </Style>
  <!-- A turn's actions show while the turn is pointed at or holds focus. -->
  <Style Selector="StackPanel.message-actions">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Border.turn:pointerover StackPanel.message-actions, Border.turn:focus-within StackPanel.message-actions">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="StackPanel.message-actions Button">
    <Setter Property="Foreground" Value="{DynamicResource muted.brush}" />
  </Style>

  <!-- Work stretches: a faint one-line summary; open, the blocks hang from a hairline on the left. -->
  <Style Selector="Expander.tool-activity">
    <Setter Property="Margin" Value="0,0,0,20" />
  </Style>
  <Style Selector="Expander.tool-activity /template/ ToggleButton#ExpanderHeader">
    <Setter Property="Padding" Value="0,5" />
    <Setter Property="Foreground" Value="{DynamicResource faint.brush}" />
  </Style>
  <!-- Hovered, the faint summary goes one step brighter, to the muted colour. -->
  <Style Selector="Expander.tool-activity /template/ ToggleButton#ExpanderHeader:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource muted.brush}" />
  </Style>
  <Style Selector="Expander.tool-activity /template/ Border#ExpanderContent">
    <Setter Property="BorderBrush" Value="{DynamicResource line.brush}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="Padding" Value="12,0,0,0" />
    <Setter Property="Margin" Value="7,5,0,0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TextBlock.activity-line">
    <Setter Property="FontFamily" Value="{DynamicResource font-secondary}" />
    <Setter Property="FontSize" Value="{DynamicResource font-size-secondary}" />
    <Setter Property="Foreground" Value="{DynamicResource faint.brush}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>
  <!-- A live line shimmers: its brightness rises and falls while the turn works on it. -->
  <Style Selector="TextBlock.activity-line.live">
    <Style.Animations>
      <Animation Duration="0:0:2.2" IterationCount="Infinite">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.55" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.55" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!-- A file a tool line or card title names, drawn as a link in the theme's link colour. FileLinkText underlines it when the theme asks. -->
  <Style Selector="Run.file-link">
    <Setter Property="Foreground" Value="{DynamicResource link.brush}" />
  </Style>
  <Style Selector="Border.tool-activity-warning > icons|Icon">
    <Setter Property="Foreground" Value="{DynamicResource warn.brush}" />
  </Style>
  <Style Selector="Border.tool-activity-warning">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector=":is(ContentControl).activity-reasoning">
    <Setter Property="Foreground" Value="{DynamicResource faint.brush}" />
  </Style>
  <Style Selector="StackPanel.tool-progress">
    <Setter Property="Margin" Value="12,4,0,0" />
  </Style>
  <Style Selector="StackPanel.tool-progress > ProgressBar">
    <Setter Property="Width" Value="120" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Height" Value="6" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource accent.brush}" />
  </Style>
  <Style Selector="TextBlock.tool-progress-text">
    <Setter Property="Foreground" Value="{DynamicResource muted.brush}" />
    <Setter Property="FontFamily" Value="{DynamicResource font-secondary}" />
    <Setter Property="FontSize" Value="{DynamicResource font-size-secondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Expander.tool-rich-inspection">
    <Setter Property="Margin" Value="12,4,0,0" />
  </Style>

  <!-- Tool call cards: the component library's card, a status dot, the tool's name in the code font, a status chip. -->
  <Style Selector="Expander.tool-call-card">
    <Setter Property="BorderBrush" Value="{DynamicResource color-border.brush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource radius-lg}" />
    <Setter Property="Background" Value="{DynamicResource color-card.brush}" />
  </Style>
  <Style Selector="Expander.tool-call-card Border.tool-call-dot">
    <Setter Property="Background" Value="{DynamicResource color-success.brush}" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>
  <Style Selector="Expander.tool-call-card.running Border.tool-call-dot">
    <Setter Property="Background" Value="{DynamicResource color-info.brush}" />
  </Style>
  <Style Selector="Expander.tool-call-card.error Border.tool-call-dot">
    <Setter Property="Background" Value="{DynamicResource color-destructive.brush}" />
  </Style>
  <Style Selector="TextBlock.tool-call-name">
    <Setter Property="FontFamily" Value="{DynamicResource font-code}" />
    <Setter Property="FontSize" Value="{DynamicResource font-size-code}" />
  </Style>
  <Style Selector="Border.tool-call-chip">
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="Margin" Value="8,0,0,0" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Background" Value="{DynamicResource color-muted.brush}" />
  </Style>
  <Style Selector="Border.tool-call-chip > TextBlock, TextBlock.tool-call-label">
    <Setter Property="FontFamily" Value="{DynamicResource font-small}" />
    <Setter Property="FontSize" Value="{DynamicResource font-size-small}" />
    <Setter Property="Foreground" Value="{DynamicResource color-muted-foreground.brush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.tool-call-block">
    <Setter Property="Padding" Value="8" />
    <Setter Property="CornerRadius" Value="{DynamicResource radius-md}" />
    <Setter Property="Background" Value="{DynamicResource color-muted.brush}" />
  </Style>
  <Style Selector="TextBlock.tool-call-text, TextBlock.tool-output-text, TextBlock.prepared-preview">
    <Setter Property="FontFamily" Value="{DynamicResource font-code}" />
    <Setter Property="FontSize" Value="{DynamicResource font-size-code}" />
  </Style>
  <Style Selector="StackPanel.tool-call-error TextBlock.tool-call-text">
    <Setter Property="Foreground" Value="{DynamicResource color-destructive.brush}" />
  </Style>
  <Style Selector="TextBlock.tool-output-text">
    <Setter Property="Margin" Value="0,5,0,12" />
  </Style>
  <Style Selector="TextBlock.tool-output-omission">
    <Setter Property="Foreground" Value="{DynamicResource faint.brush}" />
    <Setter Property="FontFamily" Value="{DynamicResource font-secondary}" />
    <Setter Property="FontSize" Value="{DynamicResource font-size-secondary}" />
  </Style>
  <Style Selector="Image.tool-output-image">
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <!-- Attachment previews: a 32 px thumbnail or the transcript image, an icon in a bordered square otherwise. -->
  <Style Selector="TextBlock.attachment-preview-name">
    <Setter Property="MaxWidth" Value="220" />
    <Setter Property="Foreground" Value="{DynamicResource muted.brush}" />
    <Setter Property="FontFamily" Value="{DynamicResource font-small}" />
    <Setter Property="FontSize" Value="{DynamicResource font-size-small}" />
  </Style>
  <Style Selector="Border.attachment-preview-icon">
    <Setter Property="BorderBrush" Value="{DynamicResource line.brush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{DynamicResource raised.brush}" />
  </Style>
  <Style Selector="Border.attachment-preview-icon > icons|Icon">
    <Setter Property="Foreground" Value="{DynamicResource muted.brush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.attachment-preview-loading > icons|Icon, Border.attachment-preview-unavailable > icons|Icon">
    <Setter Property="Foreground" Value="{DynamicResource faint.brush}" />
  </Style>
  <Style Selector="StackPanel.attachment-preview-thumbnail Border.attachment-preview-icon">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
  </Style>
  <Style Selector="StackPanel.attachment-preview-thumbnail Border.attachment-preview-icon > icons|Icon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
  </Style>
  <Style Selector="StackPanel.attachment-preview-thumbnail Image.attachment-preview-image">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Stretch" Value="UniformToFill" />
  </Style>
  <Style Selector="StackPanel.attachment-preview-display Border.attachment-preview-icon">
    <Setter Property="Width" Value="64" />
    <Setter Property="Height" Value="64" />
  </Style>
  <Style Selector="StackPanel.attachment-preview-display Border.attachment-preview-icon > icons|Icon">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
  </Style>
  <Style Selector="StackPanel.attachment-preview-display Image.attachment-preview-image">
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="TextBlock.attachment-preview-note">
    <Setter Property="Foreground" Value="{DynamicResource faint.brush}" />
    <Setter Property="FontFamily" Value="{DynamicResource font-small}" />
    <Setter Property="FontSize" Value="{DynamicResource font-size-small}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

</Styles>
