<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>An Avalonia Markdown viewer over LiveMarkdown, with Mermaid diagrams drawn by Mermaider and Svg.Skia.</Description>
    <RootNamespace>Darkspyre.Common.Avalonia.Markdown</RootNamespace>
    <Version>$(DarkspyreCommonAvaloniaMarkdownVersion)</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="LiveMarkdown.Avalonia" />
    <PackageReference Include="Mermaider" />
    <PackageReference Include="Svg.Skia" />
    <InternalsVisibleTo Include="Darkspyre.Common.Avalonia.Tests" />
  </ItemGroup>
</Project>
