<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>An Avalonia PDF viewer over the Darkspyre PDF engine contract: pages, selectable text, links, bookmarks, thumbnails, zoom and find.</Description>
    <RootNamespace>Darkspyre.Common.Avalonia.Pdf</RootNamespace>
    <Version>$(DarkspyreCommonAvaloniaPdfVersion)</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <ProjectReference Include="../Darkspyre.Common.Pdf/Darkspyre.Common.Pdf.csproj" />
    <InternalsVisibleTo Include="Darkspyre.Common.Avalonia.Tests" />
  </ItemGroup>
</Project>
